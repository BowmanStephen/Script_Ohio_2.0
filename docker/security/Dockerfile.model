# Model Execution Layer Dockerfile
# Machine Learning Model Execution with GPU Acceleration
# User: 4000:4000 (ML operations user)
# Capabilities: IPC_OWNER (shared memory), GPU access
# Devices: /dev/dri, /dev/nvidia0
# Networks: analytics-network, audit-network

FROM python:3.13-slim

# Create system user
RUN groupadd -r -g 4000 ml_user && \
    useradd -r -u 4000 -g ml_user ml_user

# Install system packages for ML operations
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        jq \
        wget \
        htop \
        iotop \
        cuda-compat-11-8 \
        libnvidia-ml-1 \
        python3-cuda-ml-1 \
        python3-nvidia-ml-12.1 \
        python3-nvidia-ml-cu12 \
        python3-nvidia-ml-nccl \
        python3-typing-extensions \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install ML dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install additional ML packages
RUN pip install --no-cache-dir \
    torch==2.1.0 \
    torchvision==0.16.0 \
    tensorflow==2.14.0 \
    xgboost==2.0.2 \
    scikit-learn==1.5.1 \
    pandas==2.2.2 \
    numpy==1.26.2 \
    matplotlib==3.8.2 \
    seaborn==0.13.0 \
    plotly==5.17.0 \
    dash==2.14.1 \
    redis==5.0.1 \
    joblib==1.3.2 \
    dill==0.3.7 \
    psutil==5.9.6

# Copy application code
COPY src/ ./src/
COPY models/ ./models/
COPY agents/analytics/ ./agents/analytics/
COPY agents/core/ ./agents/core/
COPY docker/security/scripts/start-model.sh ./
COPY docker/security/scripts/health-check.sh ./

# Create model and cache directories
RUN mkdir -p /app/models /app/cache /app/logs /app/predictions && \
    chown -R ml_user:ml_user /app && \
    chmod -R 755 /app

# Copy security configuration
COPY docker/security/security-policies.json /etc/agent-security/
COPY docker/security/model-security.json /etc/agent-security/
RUN chmod 600 /etc/agent-security/security-policies.json && \
    chmod 600 /etc/agent-security/model-security.json

# Set ownership
RUN chown -R ml_user:ml_user /app

# Switch to non-root user
USER ml_user

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["./health-check.sh"]

# Expose port for model service interface
EXPOSE 8200

# Start command
CMD ["./start-model.sh"]