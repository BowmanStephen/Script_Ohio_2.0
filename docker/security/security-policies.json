{
  "version": "1.0.0",
  "policies": {
    "authentication": {
      "required": true,
      "methods": ["jwt", "api_key"],
      "jwt_expiry": 3600,
      "api_key_rotation": 86400
    },
    "authorization": {
      "role_based_access": true,
      "least_privilege": true,
      "separation_of_duties": true
    },
    "encryption": {
      "at_rest": {
        "algorithm": "AES-256-GCM",
        "key_rotation_days": 90
      },
      "in_transit": {
        "protocol": "TLS 1.3",
        "certificate_rotation_days": 30
      }
    },
    "audit_logging": {
      "enabled": true,
      "log_level": "INFO",
      "retention_days": 365,
      "include_payloads": false,
      "include_headers": true
    },
    "rate_limiting": {
      "default": {
        "requests_per_minute": 60,
        "burst_size": 10
      },
      "cfbd_api": {
        "requests_per_minute": 30,
        "burst_size": 5
      },
      "weather_api": {
        "requests_per_minute": 60,
        "burst_size": 10
      }
    },
    "security_context": {
      "no_new_privileges": true,
      "apparmor_profile": "docker-default",
      "seccomp_profile": "default",
      "read_only_filesystem": false,
      "tmpfs_size": "1G"
    },
    "network_security": {
      "allowed_ports": [8000, 8100, 8200, 8300, 8400, 8500, 8600, 8700, 8800, 8900, 9000, 9100, 9200],
      "blocked_protocols": ["telnet", "ftp", "rsh"],
      "egress_filtering": true,
      "ingress_filtering": true
    },
    "resource_limits": {
      "memory": {
        "max_container_mb": 8192,
        "warning_threshold_percent": 80
      },
      "cpu": {
        "max_cores": 4,
        "warning_threshold_percent": 85
      },
      "disk": {
        "warning_threshold_percent": 85
      }
    },
    "threat_detection": {
      "enabled": true,
      "anomaly_detection": true,
      "behavioral_analysis": true,
      "alert_threshold": "medium",
      "automatic_response": true
    },
    "backup_and_recovery": {
      "automated_backups": true,
      "backup_frequency_hours": 24,
      "retention_days": 30,
      "encryption_required": true,
      "integrity_verification": true
    }
  },
  "compliance": {
    "standards": ["SOC2", "ISO27001", "GDPR"],
    "data_classification": {
      "public": {
        "encryption_required": false,
        "access_level": "read_only"
      },
      "internal": {
        "encryption_required": true,
        "access_level": "read_write"
      },
      "confidential": {
        "encryption_required": true,
        "access_level": "restricted"
      },
      "restricted": {
        "encryption_required": true,
        "access_level": "admin_only"
      }
    }
  },
  "incident_response": {
    "escalation_policy": {
      "low": {
        "response_time_minutes": 60,
        "notification": ["email", "log"]
      },
      "medium": {
        "response_time_minutes": 15,
        "notification": ["email", "slack", "log"]
      },
      "high": {
        "response_time_minutes": 5,
        "notification": ["email", "slack", "sms", "log"]
      },
      "critical": {
        "response_time_minutes": 1,
        "notification": ["email", "slack", "sms", "phone", "log"]
      }
    },
    "automated_responses": {
      "suspicious_login": ["lock_account", "notify_admin"],
      "data_exfiltration": ["isolate_container", "notify_admin", "preserve_evidence"],
      "resource_abuse": ["throttle_access", "notify_admin"],
      "security_breach": ["isolate_system", "preserve_evidence", "notify_admin", "initiate_incident_response"]
    }
  }
}